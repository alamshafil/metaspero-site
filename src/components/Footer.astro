---
import { SITE_CONFIG } from '../config/site';

const currentYear = new Date().getFullYear();

const navLinks = [
  { label: 'Compatibility', href: '/compatibility' },
  { label: 'Submit Report', href: '/report' },
  { label: 'Compile Guide', href: '/docs/compile' },
  { label: 'FAQ', href: '/faq' },
];

const externalLinks = [
  { label: 'GitHub: Metaspero', href: SITE_CONFIG.links.github },
  { label: 'GitHub: FEXCore-Darwin', href: SITE_CONFIG.links.fexCoreDarwin },
  { label: 'GitHub: Website Source', href: SITE_CONFIG.links.websiteRepo },
  { label: 'KytyPS5 Upstream', href: SITE_CONFIG.links.kytyPS5Upstream },
];
---

<footer class="border-t border-zinc-200/80 mt-24 bg-footer">
  <div class="max-w-[1100px] mx-auto px-6 pt-16 pb-12 grid grid-cols-1 md:grid-cols-3 gap-12">
    <div class="max-w-sm">
      <a href="/" class="inline-flex items-center gap-2 font-semibold text-sm text-zinc-900 hover:text-zinc-600 transition-colors mb-3">
        <img
          src="/app-icon.png"
          alt=""
          width="20"
          height="20"
          class="w-5 h-5 rounded select-none"
        />
        <span>{SITE_CONFIG.name}</span>
      </a>
      <p class="text-sm text-zinc-600 leading-relaxed">
        Experimental PlayStation 5 emulator for iOS and macOS, based on KytyPS5 with FEXCore and MoltenVK.
      </p>
    </div>

    <div class="flex flex-col gap-2">
      <h4 class="text-xs font-semibold text-zinc-900 tracking-wide uppercase mb-1">Documentation</h4>
      {navLinks.map((link) => (
        <a href={link.href} class="text-sm text-zinc-500 hover:text-zinc-900 transition-colors">{link.label}</a>
      ))}
    </div>

    <div class="flex flex-col gap-2">
      <h4 class="text-xs font-semibold text-zinc-900 tracking-wide uppercase mb-1">Projects & Upstream</h4>
      {externalLinks.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-zinc-500 hover:text-zinc-900 transition-colors"
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>

  <div class="border-t border-zinc-200/60">
    <div class="max-w-[1100px] mx-auto px-6 py-6 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-zinc-400">
      <p class="m-0">
        &copy; {currentYear} {SITE_CONFIG.author.name} &middot; Not affiliated with Sony Interactive Entertainment.
      </p>
      <button id="return-to-top" class="text-xs text-zinc-400 hover:text-zinc-600 transition-colors cursor-pointer">
        Return to Top &uarr;
      </button>
    </div>
  </div>
</footer>

<script>
  document.getElementById('return-to-top')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
